# =========================================================
# SEGURANÇA
# =========================================================

# Chave secreta do Django (apenas para assinatura de sessão/JWT).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-me-with-a-long-random-secret

# Chave DEDICADA para criptografar dados sensíveis em repouso (tokens Meta).
# Separada do SECRET_KEY. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Em produção use sempre DEBUG=False.
DEBUG=True

# =========================================================
# CAPTCHA (Cloudflare Turnstile) — protege o registro contra bots
# =========================================================
# Desligado por padrão (dev/testes não precisam de chaves).
# Em produção: CAPTCHA_ENABLED=True e preencha as chaves do painel Turnstile.
CAPTCHA_ENABLED=False
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Liste explicitamente os hosts/domínios permitidos (sem wildcards).
ALLOWED_HOSTS=127.0.0.1,localhost

# =========================================================
# CORS (sem wildcards, sem faixas privadas, sem túneis temporários)
# =========================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Regexes opcionais (separados por vírgula). Deixe vazio em produção, salvo necessidade.
CORS_ALLOWED_ORIGIN_REGEXES=

# =========================================================
# BANCO DE DADOS
# =========================================================
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# =========================================================
# HTTPS / PRODUÇÃO
# =========================================================
SECURE_SSL_REDIRECT=False

# =========================================================
# RATE LIMITING / PROXY (anti-spoofing de X-Forwarded-For)
# =========================================================
# Nº de proxies confiáveis à frente da aplicação. Determina como o IP do
# cliente é extraído para o rate limiting:
#   0 -> app exposto direto: ignora X-Forwarded-For, usa só o IP da conexão.
#   1 -> atrás de 1 proxy (nginx/Cloudflare/túnel) que sobrescreve/anexa o XFF.
# Defina conforme sua topologia de deploy. NUNCA deixe alto "por garantia":
# cada proxy a mais é um IP que o atacante pode forjar.
NUM_PROXIES=0
#
# IMPORTANTE (produção): o throttling do DRF guarda os contadores no cache do
# Django. O padrão (LocMemCache) é por-processo e some no restart — com vários
# workers o limite efetivo multiplica. Use um cache compartilhado (Redis):
#   CACHE_URL=redis://127.0.0.1:6379/1
# e configure CACHES em settings.py apontando para ele.

# =========================================================
# BLOQUEIO DE LOGIN POR CONTA (anti brute force, independente de IP)
# =========================================================
# Trava temporária após N falhas de senha numa conta. Conta só FALHAS e zera
# no login correto. Duas camadas: rajada (curta) e sustentada (mais longa).
#   Rajada: LOGIN_FAIL_BURST falhas em LOGIN_FAIL_BURST_WINDOW segundos.
#   Sustentada: LOGIN_FAIL_WINDOW_MAX falhas em LOGIN_FAIL_WINDOW_SECONDS seg.
# Quanto maior a janela, mais seguro contra brute force, porém maior o tempo de
# bloqueio de um usuário legítimo (e o risco de lockout/DoS proposital).
LOGIN_FAIL_BURST=5
LOGIN_FAIL_BURST_WINDOW=300
LOGIN_FAIL_WINDOW_MAX=20
LOGIN_FAIL_WINDOW_SECONDS=3600

# =========================================================
# INTEGRAÇÃO META / FACEBOOK (use valores reais apenas no .env, nunca aqui)
# =========================================================
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/meta/auth/callback/
FRONTEND_URL=http://localhost:5173
SITE_URL=http://localhost:8000
MEDIA_PUBLIC_URL=http://localhost:8000/media/

# =========================================================
# FRONTEND (Vite)
# =========================================================
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_MEDIA_BASE_URL=http://127.0.0.1:8000
# Site key pública do Cloudflare Turnstile (mesma chave do TURNSTILE_SITE_KEY).
# Deixe vazio em dev para não exibir o widget.
VITE_TURNSTILE_SITE_KEY=
